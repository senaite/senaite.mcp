#!/usr/bin/env bash
#
# Smoke-test the connection to the configured SENAITE instance:
# print the API version and a few content counts.
#
set -eu

HERE="$(cd "$(dirname "$0")/.." && pwd)"
cd "$HERE"

if [ -f .env ]; then
    set -a
    . ./.env
    set +a
fi

PYENV_ROOT="${PYENV_ROOT:-$HOME/.pyenv}"
exec "$PYENV_ROOT/versions/senaite.mcp/bin/python" - <<'PY'
from senaite_mcp.config import Settings
from senaite_mcp.client import SenaiteClient

client = SenaiteClient(Settings.from_env())
print("api_url: %s" % client.api_url)
print("version: %s" % client.version().get("version"))
for portal_type in ("Client", "Contact", "AnalysisService", "AnalysisRequest"):
    count = client.search({"portal_type": portal_type, "limit": 1}).get("count")
    print("  %-16s %s" % (portal_type, count))
client.close()
PY
