#!/usr/bin/env bash
#
# Run the SENAITE MCP server from this checkout.
#
# Reads connection settings from .env if present, then runs the
# senaite-mcp found in .venv, in a pyenv virtualenv named senaite.mcp,
# or on PATH, in that order. Arguments pass through, e.g. --check.
# Register this script with an MCP host:
#
#   claude mcp add senaite -- /path/to/senaite.mcp/bin/serve
#
set -eu

HERE="$(cd "$(dirname "$0")/.." && pwd)"
. "$HERE/bin/_env"

exec "$(find_tool senaite-mcp)" "$@"
