# Copy to .env and adjust. Consumed by your MCP host / shell.
SENAITE_URL=http://localhost:8080/senaite
SENAITE_USERNAME=admin
SENAITE_PASSWORD=admin
SENAITE_TIMEOUT=30
SENAITE_VERIFY_SSL=true

# Transport. Default 'stdio' (the host launches this as a subprocess).
# Set 'streamable-http' (or 'sse') to run as a networked server; host
# defaults to 127.0.0.1 on purpose -- see README before exposing it.
# SENAITE_MCP_TRANSPORT=stdio
# SENAITE_MCP_HOST=127.0.0.1
# SENAITE_MCP_PORT=7980
